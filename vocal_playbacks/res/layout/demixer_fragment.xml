<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎤 יוצר הפלייבקים"
            android:textColor="@color/colorPrimaryText"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="מעלים שיר ומקבלים ווקאלי + פלייבק"
            android:textColor="#7B6D84"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="18dp"/>

        <LinearLayout
            android:id="@+id/musicInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tvMusicInputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎵 שלב 1 · בחירת שיר"
                android:textColor="@color/colorPrimaryText"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnUploadAudio"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="📂 בחר שיר מהמכשיר"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textColor="@color/colorWhite"
                android:backgroundTint="@color/colorHeader"/>

            <TextView
                android:id="@+id/tvSelectedInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="עדיין לא נבחר שיר"
                android:textColor="#7B6D84"
                android:textSize="14sp"
                android:paddingTop="10dp"/>

            <Button
                android:id="@+id/btnRecordControls"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>
            <Button
                android:id="@+id/btnAppCaptureControls"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/demixControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="14dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tvStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ שלב 2 · הפרדה"
                android:textColor="@color/colorPrimaryText"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnStartJob"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:text="✨ הפרד את השיר"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorWhite"
                android:background="@drawable/bg_primary"/>

            <Button
                android:id="@+id/btnStopJob"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="עצור"
                android:textAllCaps="false"
                android:enabled="false"/>

            <Button
                android:id="@+id/btnClearLogs"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progressLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="14dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏳ מעבדים את השיר…"
                android:textColor="@color/colorPrimaryText"
                android:textSize="16sp"/>

            <ProgressBar
                android:id="@+id/progressBarJob"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:max="100"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/terminalLayout"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="14dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tvStemOutputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="התוצאות יופיעו כאן אחרי ההפרדה"
                android:textColor="@color/colorPrimaryText"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <ScrollView
                android:id="@+id/scrollViewLogs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvTerminalLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#75697D"
                    android:textSize="12sp"/>
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/stemsOutputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎧 שלב 3 · הורדה"
                android:textColor="@color/colorPrimaryText"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="נשמור באותה תיקייה שני קבצי WAV: ווקאלי.wav ופלייבק.wav"
                android:textColor="#7B6D84"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"/>

            <Button
                android:id="@+id/btnStemOutputs"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="⬇️ הורד ווקאלי + פלייבק"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textColor="@color/colorWhite"
                android:backgroundTint="#EC4899"
                android:enabled="false"/>

            <Button
                android:id="@+id/btnCustomMix"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>
        </LinearLayout>

        <View
            android:id="@+id/startRuler"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>